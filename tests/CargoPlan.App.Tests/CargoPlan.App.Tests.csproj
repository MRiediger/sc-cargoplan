<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Linux compiles this project (EnableWindowsTargeting in CI) but can't run it: there is no
       Microsoft.WindowsDesktop.App runtime. dotnet test only runs projects with IsTestProject == 'true'
       (VSTest target in the SDK's Microsoft.TestPlatform.targets), so Linux skips it. See D12. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CargoPlan.App\CargoPlan.App.csproj" />
  </ItemGroup>

  <!-- The Core fixture with a split and a shared rack, linked instead of copied: the ship view tests draw it (TestPlans). -->
  <ItemGroup>
    <EmbeddedResource Include="..\CargoPlan.Core.Tests\Fixtures\split_and_shared.json"
                      LogicalName="missions/split_and_shared.json" Link="Fixtures\split_and_shared.json" />
  </ItemGroup>

</Project>
