<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Keeps the Timing category out of the default run, like the Core tests (K2.4).
         https://learn.microsoft.com/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file#set-a-build-property -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\default.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- Linux compiles this project (EnableWindowsTargeting in CI) but can't run it: there is no
       Microsoft.WindowsDesktop.App runtime. dotnet test only runs projects with IsTestProject == 'true'
       (VSTest target in the SDK's Microsoft.TestPlatform.targets), so Linux skips it. See D12. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CargoPlan.App\CargoPlan.App.csproj" />
  </ItemGroup>

  <!-- The Core fixture with a split and a shared rack, linked instead of copied: the ship view tests draw it (TestPlans). -->
  <ItemGroup>
    <EmbeddedResource Include="..\CargoPlan.Core.Tests\Fixtures\split_and_shared.json"
                      LogicalName="missions/split_and_shared.json" Link="Fixtures\split_and_shared.json" />
    <!-- The T7.0 load case, eight stops: what an undo costs (UndoTimingTests, K2.4). -->
    <EmbeddedResource Include="..\CargoPlan.Core.Tests\Fixtures\hull_a_eight_stops.json"
                      LogicalName="missions/hull_a_eight_stops.json" Link="Fixtures\hull_a_eight_stops.json" />
  </ItemGroup>

  <!-- Martin's plan of 25 Oct with ContractTracker's raw pickup text (B6), the Import tests' fixture linked like the one above. -->
  <ItemGroup>
    <EmbeddedResource Include="..\CargoPlan.Import.Tests\Fixtures\Plans\hurston_2026-10-25.json"
                      LogicalName="plans/hurston_2026-10-25.json" Link="Fixtures\hurston_2026-10-25.json" />
  </ItemGroup>

  <!-- The synthetic SCH2 writer of Core's hologram tests, linked like the fixture above: the hologram view and loader
       tests need a valid file, and no game model may enter the repo (D63). -->
  <ItemGroup>
    <Compile Include="..\CargoPlan.Core.Tests\HoloFixtures.cs" Link="HoloFixtures.cs" />
  </ItemGroup>

  <!-- The overlay's markup, read as XML by OverlayHeaderXamlTests: what stays visible while locked (D67). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\CargoPlan.App\OverlayWindow.xaml"
                      LogicalName="xaml/OverlayWindow.xaml" Link="Xaml\OverlayWindow.xaml" />
  </ItemGroup>

  <!-- The settings window's markup, read by SettingsWindowXamlTests: slider bounds must be doubles (T7.4c-2 crash). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\CargoPlan.App\SettingsWindow.xaml"
                      LogicalName="xaml/SettingsWindow.xaml" Link="Xaml\SettingsWindow.xaml" />
  </ItemGroup>

</Project>
