<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CargoPlan.Core\CargoPlan.Core.csproj" />
  </ItemGroup>

  <!-- Broken ship files for ShipLoaderTests. Same "ships/<file>.json" naming as in Core,
       independent of namespace and folder. -->
  <ItemGroup>
    <None Remove="TestShips/*.json" />
    <EmbeddedResource Include="TestShips/*.json" LogicalName="ships/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Mission files for tests, read via MissionFixtures. The files stay on disk as well,
       so the CLI can use them as examples. -->
  <ItemGroup>
    <None Remove="Fixtures/**/*.json" />
    <EmbeddedResource Include="Fixtures/*.json" LogicalName="missions/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Invalid/*.json" LogicalName="missions/invalid/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>