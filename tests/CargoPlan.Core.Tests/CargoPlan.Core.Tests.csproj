<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Leaves the exhaustive layout check out of the default run (see the file). Project-level run settings:
         https://learn.microsoft.com/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file#set-a-build-property -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\default.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CargoPlan.Core\CargoPlan.Core.csproj" />
  </ItemGroup>

  <!-- Broken and synthetic ship files, read from TestShips/ next to the test assembly like ships/ next to the exe (D56). -->
  <ItemGroup>
    <None Update="TestShips/*.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Fleetyards import (T7.1b): the script under test, linked from tools/ so the test needn't search the repo root,
       a synthetic export and the ship files it must produce. -->
  <ItemGroup>
    <None Include="..\..\tools\import-fleetyards.ps1" Link="tools\import-fleetyards.ps1" CopyToOutputDirectory="IfDifferent" />
    <None Update="TestFleetyards/**/*.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Mission files for tests, read via MissionFixtures. The files stay on disk as well,
       so the CLI can use them as examples. -->
  <ItemGroup>
    <None Remove="Fixtures/**/*.json" />
    <EmbeddedResource Include="Fixtures/*.json" LogicalName="missions/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Invalid/*.json" LogicalName="missions/invalid/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Plan files for PlanFileTests. They stay on disk as well, for the overlay's plan start switch. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/Plans/*.json" LogicalName="plans/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>