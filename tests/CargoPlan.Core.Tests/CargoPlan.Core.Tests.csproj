<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Leaves the exhaustive layout check out of the default run (see the file). Project-level run settings:
         https://learn.microsoft.com/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file#set-a-build-property -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)\default.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CargoPlan.Core\CargoPlan.Core.csproj" />
  </ItemGroup>

  <!-- Broken and synthetic ship files, read from TestShips/ next to the test assembly like the baseline's ships next to the exe (D56, D113). -->
  <ItemGroup>
    <None Update="TestShips/*.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Shipped ships frozen before the game-file racks (D92): mechanics tests load these, never the shipped data, so a
       data release moves no test. Data tests check the baseline in ship-data/ itself (D113). -->
  <ItemGroup>
    <None Update="FrozenShips/**/*.json" CopyToOutputDirectory="IfDifferent" />
    <None Update="FrozenOutlines/ship-outlines.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Broken and synthetic outline files for the outline loader (D55). -->
  <ItemGroup>
    <None Update="TestOutlines/*.json" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- The ship data fetch (T12.5, D113), linked from tools/ so the test runs the script the build runs. -->
  <ItemGroup>
    <None Include="..\..\tools\fetch-ship-data.ps1" Link="tools\fetch-ship-data.ps1" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Mission files for tests, read via MissionFixtures. The files stay on disk as well,
       so the CLI can use them as examples. -->
  <ItemGroup>
    <None Remove="Fixtures/**/*.json" />
    <EmbeddedResource Include="Fixtures/*.json" LogicalName="missions/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fixtures/Invalid/*.json" LogicalName="missions/invalid/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Plan files for PlanFileTests. They stay on disk as well, for the overlay's plan start switch. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/Plans/*.json" LogicalName="plans/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>