<?xml version="1.0" encoding="utf-8"?>
<!--
  Default run of the Core tests: the exhaustive layout check (Trait "Category" = "Exhaustive") takes too long for every
  run and stays out. The command that runs it alone is in CLAUDE.md (Befehle): it empties RunSettingsFilePath, because a
  filter on the command line is joined with this one by AND, and an inline TestCaseFilter doesn't replace it (tried).
  RunConfiguration/TestCaseFilter: https://learn.microsoft.com/visualstudio/test/configure-unit-tests-by-using-a-dot-runsettings-file
  xUnit traits as filter properties: https://learn.microsoft.com/dotnet/core/tools/dotnet-test-vstest#filter-option-details
-->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category!=Exhaustive</TestCaseFilter>
  </RunConfiguration>
</RunSettings>
