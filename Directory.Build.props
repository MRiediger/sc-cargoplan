<Project>

  <!-- Imported automatically by every project below this folder. Project-specific
       settings (TargetFramework, OutputType, UseWPF) stay in the .csproj files. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keeps only English satellite assemblies, like the UI (D50). Also filters the WPF runtime pack's 13 language
         folders in the self-contained publish; localization (T7.5) has to add its language here.
         Source: https://github.com/dotnet/sdk/blob/main/src/Tasks/Microsoft.NET.Build.Tasks/ResolveRuntimePackAssets.cs -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release metadata. A release build overrides Version with the tag (T6.3); the SDK appends the commit hash to
       the informational version (0.0.0-dev+<sha>), which the settings footer and the CLI's version option show.
       Source: https://learn.microsoft.com/en-us/dotnet/core/compatibility/sdk/8.0/source-link -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Authors>MRiediger</Authors>
    <Product>SC-CargoPlan</Product>
    <Copyright>Copyright (c) 2026 MRiediger</Copyright>
    <RepositoryUrl>https://github.com/MRiediger/sc-cargoplan</RepositoryUrl>
  </PropertyGroup>

</Project>
