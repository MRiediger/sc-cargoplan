<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CargoPlan.Core.Tests" />
  </ItemGroup>

  <!-- Ship layouts live in the repo's ships/ folder and are copied to ships/ next to every exe and test assembly that
       references Core, and into the publish folder (D56). Adding a ship = adding a file. IfDifferent, not PreserveNewest:
       a file restored by git keeps an older timestamp and would not be copied.
       Source: https://learn.microsoft.com/visualstudio/msbuild/common-msbuild-project-items -->
  <ItemGroup>
    <None Include="..\..\ships\*.json" Link="ships\%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
    <!-- Cargo modules (K5.3, D59): a subfolder, which the pattern above doesn't reach. -->
    <None Include="..\..\ships\modules\*.json" Link="ships\modules\%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- Ship outlines (D55) the same way, with their licence note: not under the repo's MIT licence, so a folder of their own. -->
  <ItemGroup>
    <None Include="..\..\outlines\*" Link="outlines\%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

</Project>
