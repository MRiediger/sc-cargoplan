<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CargoPlan.Core.Tests" />
  </ItemGroup>

  <!-- Ship layouts live in the repo's ships/ folder and are copied to ships/ next to every exe and test assembly that
       references Core, and into the publish folder (D56). Adding a ship = adding a file. IfDifferent, not PreserveNewest:
       a file restored by git keeps an older timestamp and would not be copied.
       Source: https://learn.microsoft.com/visualstudio/msbuild/common-msbuild-project-items -->
  <ItemGroup>
    <None Include="..\..\ships\*.json" Link="ships\%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

</Project>
