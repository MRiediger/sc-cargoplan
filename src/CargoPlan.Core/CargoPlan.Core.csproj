<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CargoPlan.Core.Tests" />
  </ItemGroup>

  <!-- Ship layouts are compiled into the DLL. The explicit LogicalName ("ships/hull_a.json")
       keeps resource names independent of namespace and folder. Adding a ship = adding a file. -->
  <ItemGroup>
    <None Remove="Ships/*.json" />
    <EmbeddedResource Include="Ships/*.json" LogicalName="ships/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
