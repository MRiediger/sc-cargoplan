<Window x:Class="CargoPlan.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        MaxWidth="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterOwner">
    <!-- A yes/no question in the middle of the window it came from (Martin, B4): the system's message box centres on the
         monitor, where nobody looks while the overlay sits in a corner. Fluent like the other tool windows (D36); topmost
         like the editor, so it stands above the topmost overlay and the game. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="Question" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" Content="Yes" MinWidth="80" Click="OnYes" />
            <Button x:Name="NoButton" Content="No" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
