<Window x:Class="CargoPlan.App.MissionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CargoPlan.App.ViewModels"
        xmlns:ed="clr-namespace:CargoPlan.App.Editor"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MissionEditorViewModel}"
        Title="{Binding Title}"
        Width="660" Height="420"
        MinWidth="480" MinHeight="260"
        Topmost="True"
        ShowInTaskbar="True"
        ShowActivated="False"
        WindowStartupLocation="CenterOwner">
    <!-- A normal window: here the player types, so it takes the focus on purpose (no WS_EX_NOACTIVATE, no click-through).
         Topmost comes with the topmost overlay as owner anyway. ShowActivated=False is for showing it again after the
         auto-lock (D19); opening it calls Activate() explicitly. Fluent light or dark, like the settings window (D36). -->

    <!-- ButtonBase.Click bubbles before the button runs its command: every button first ends the cell edit,
         because moving or removing rows during an edit transaction throws.
         Source: ButtonBase.OnClick raises Click, then executes the command (dotnet/wpf, ButtonBase.cs). -->
    <DockPanel Margin="8" ButtonBase.Click="OnAnyButtonClick">
        <!-- One level below the window, so BasedOn finds Fluent's styles (D36). -->
        <DockPanel.Resources>
            <ed:SelectedRowConverter x:Key="SelectedRowConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Padding" Value="8,2" />
            </Style>
        </DockPanel.Resources>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add" Command="{Binding AddRowCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="Add a row (or type into the empty row at the bottom)" />
            <Button Content="Remove" Command="{Binding RemoveRowCommand}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Delete mission" Command="{Binding DeleteMissionCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="Take the selected row's mission out of the plan now, with its crates; nothing else moves, no need to press Plan. Typed rows of one stop are one mission." />
            <Button Content="↑" Command="{Binding MoveUpCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="Move up: stops follow the first row of each destination" />
            <Button Content="↓" Command="{Binding MoveDownCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="Move down" />
            <Button Content="Clear rows" Command="{Binding ClearRowsCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    Margin="12,0,4,0" ToolTip="Start the next route; the overlay keeps its plan until you plan again" />
            <Button Content="Import…" Click="OnImport" Style="{StaticResource ToolbarButtonStyle}" Margin="12,0,4,0"
                    ToolTip="Replace the rows with a mission file" />
            <!-- "Sync", not "Load": Import… next to it replaces the rows, this adds new captures to the plan (T5.4). -->
            <Button Content="Sync from ContractTracker" Command="{Binding SyncCommand}" Style="{StaticResource ToolbarButtonStyle}"
                    ToolTip="Add contracts captured in ContractTracker to the plan, and place waiting missions that fit now" />
            <Button Content="Export…" Click="OnExport" IsEnabled="{Binding CanExport}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="Copy as text" Click="OnCopyText" IsEnabled="{Binding HasPlan}" Style="{StaticResource ToolbarButtonStyle}"
                    Margin="12,0,0,0" ToolTip="Copy the current plan for Discord or org chat" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Plan" Command="{Binding PlanCommand}" Padding="16,4"
                    VerticalAlignment="Bottom" ToolTip="Plan the rows and show them in the overlay" />
            <!-- Next to Plan, because it takes effect there (D24, T4.5). "Fill order" as the key in plan.json, so the word
                 is found again in the file. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,8,0"
                        ToolTip="Which end of each rack the crates fill from. Takes effect when you press Plan.">
                <TextBlock Text="Fill order:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{x:Static vm:MissionEditorViewModel.FillOrders}" DisplayMemberPath="Text"
                          SelectedValuePath="Value" SelectedValue="{Binding FillOrder}" MinWidth="90" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static vm:MissionEditorViewModel.ClearsDeliveredText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding ClearsDelivered, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </DockPanel>

        <!-- Bindings with UpdateSourceTrigger=PropertyChanged: the data grid would otherwise commit only at the end of the
             edit, and the stop column, the red row and the Plan button would lag behind the typing.
             Sorting is off: it would reorder the view, not the route. Fluent's row and cell templates paint a fixed
             transparent background, so an invalid row gets a frame instead of a tint: the row template binds BorderBrush.
             Rows and headers are keyed Fluent styles the grid sets, there is no implicit one to base on (D36).
             Source: dotnet/wpf, PresentationFramework.Fluent/Styles/DataGrid.xaml -->
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Converter={StaticResource SelectedRowConverter}}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="ToolTip" Value="{Binding Error}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Stop" Binding="{Binding StopNumber}" IsReadOnly="True" Width="Auto" />
                <!-- Where the row came from: "ct 37–38" for a ContractTracker capture, empty if typed (T5.4). -->
                <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneTime}" IsReadOnly="True" Width="Auto" />
                <DataGridTextColumn Header="Destination" Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="Commodity" Binding="{Binding Commodity, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                <DataGridTextColumn Header="SCU" Binding="{Binding Scu, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridComboBoxColumn Header="Max crate"
                                        ItemsSource="{x:Static ed:MissionRows.MaxCrateSizes}"
                                        SelectedItemBinding="{Binding MaxCrateSize, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" />
                <!-- Shows the crates derived from SCU and max (D23), or the ones typed by hand in italics. Editing starts
                     empty for a derived row, so clicking in and out never turns the derivation into an override;
                     an empty box means "derive again". FocusManager puts the caret into the box when editing starts.
                     Source: https://learn.microsoft.com/dotnet/api/system.windows.input.focusmanager.focusedelement -->
                <DataGridTemplateColumn Header="Crates" Width="1.5*">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
                            <Setter Property="ToolTip" Value="{x:Static ed:MissionRows.CratesToolTipText}" />
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="ed:MissionRow">
                            <TextBlock Text="{Binding CratesText}" ToolTip="{x:Static ed:MissionRows.CratesToolTipText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCrateOverride}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="ed:MissionRow">
                            <TextBox Text="{Binding Crates, UpdateSourceTrigger=PropertyChanged}"
                                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                                     FontStyle="Italic" BorderThickness="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
