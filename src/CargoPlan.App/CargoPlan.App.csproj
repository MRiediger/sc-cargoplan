<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CargoPlan.Core\CargoPlan.Core.csproj" />
    <ProjectReference Include="..\CargoPlan.Import\CargoPlan.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- [LibraryImport] generates unsafe marshalling code.
         Source: https://learn.microsoft.com/en-us/dotnet/standard/native-interop/pinvoke-source-generation -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Placeholder plan until the mission editor (T3.8): the test fixture, linked instead of copied,
       embedded so it also works inside the single-file EXE. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\CargoPlan.Core.Tests\Fixtures\example_missions.json"
                      LogicalName="missions/example_missions.json" Link="Samples\example_missions.json" />
  </ItemGroup>

</Project>
