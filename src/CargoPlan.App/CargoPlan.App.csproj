<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CargoPlan.Core\CargoPlan.Core.csproj" />
    <ProjectReference Include="..\CargoPlan.Import\CargoPlan.Import.csproj" />
    <!-- Reads contracts from the game window (T10.1b, D99): brings ONNX Runtime, SkiaSharp and models/v5 into the output. -->
    <ProjectReference Include="..\CargoPlan.Ocr\CargoPlan.Ocr.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The app updates itself (D109, S11.0): pinned, the same version as the vpk tool that packs the release (T11.3).
         Under net10.0 it brings only Velopack.dll (279 KB), no further package. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- The look presets (K4.3, D77), read by LookPresets.Open; a fixed name instead of the namespace-derived default.
       Source: https://learn.microsoft.com/visualstudio/msbuild/common-msbuild-project-items#embeddedresource -->
  <ItemGroup>
    <EmbeddedResource Include="Looks\*.cargoplan-look.json" LogicalName="looks/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- The VR mode (D131): Valve's OpenVR SDK v2.15.6 (BSD-3-Clause), byte-identical files from ValveSoftware/openvr.
       openvr_api.cs compiles through the default glob; the native library goes next to the exe, where the binding's
       [DllImport("openvr_api")] looks; the licence goes to openvr\ because LICENSE at the root is ours (T14.1). -->
  <ItemGroup>
    <None Include="Vr\OpenVR\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="IfDifferent" />
    <None Include="Vr\OpenVR\LICENSE" Link="openvr\LICENSE.txt" CopyToOutputDirectory="IfDifferent" />
  </ItemGroup>

  <!-- The view tests click the live control through its internal press and release (T8.3, R4): no public API for tests.
       Source: https://learn.microsoft.com/dotnet/standard/assembly/set-attributes-project-file#set-arbitrary-attributes -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CargoPlan.App.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The theme sample (T4.7a) is a developer window: not in the Release build. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="ThemeSampleWindow.xaml" />
    <Compile Remove="ThemeSampleWindow.xaml.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- [LibraryImport] generates unsafe marshalling code.
         Source: https://learn.microsoft.com/en-us/dotnet/standard/native-interop/pinvoke-source-generation -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Exe and Explorer icon; a window without its own Icon takes it too (title bar, taskbar, Alt+Tab). Source of the image:
         docs/images/icon.svg (K5.4). Source: https://learn.microsoft.com/dotnet/api/system.windows.window.icon#remarks -->
    <ApplicationIcon>cargoplan.ico</ApplicationIcon>
    <!-- Our own Main (Program.cs): Velopack must run before WPF starts (D109, CLAUDE.md A14). -->
    <StartupObject>CargoPlan.App.Program</StartupObject>
  </PropertyGroup>

</Project>
