<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CargoPlan.Core\CargoPlan.Core.csproj" />
    <ProjectReference Include="..\CargoPlan.Import\CargoPlan.Import.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- The look presets (K4.3, D77), read by LookPresets.Open; a fixed name instead of the namespace-derived default.
       Source: https://learn.microsoft.com/visualstudio/msbuild/common-msbuild-project-items#embeddedresource -->
  <ItemGroup>
    <EmbeddedResource Include="Looks\*.cargoplan-look.json" LogicalName="looks/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- The theme sample (T4.7a) is a developer window: not in the Release build. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="ThemeSampleWindow.xaml" />
    <Compile Remove="ThemeSampleWindow.xaml.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- [LibraryImport] generates unsafe marshalling code.
         Source: https://learn.microsoft.com/en-us/dotnet/standard/native-interop/pinvoke-source-generation -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
