<Window x:Class="CargoPlan.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CargoPlan.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="SC-CargoPlan"
        Width="520" Height="200"
        MinWidth="200" MinHeight="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <!-- Click-through is not set here: it is a mode (IsLocked), switched in code-behind, see D11. -->
    <!-- MinWidth/MinHeight: the lock window and a few lines stay visible; restoring saved bounds uses them too. -->
    <Border Background="{StaticResource OverlayBackgroundBrush}" CornerRadius="4" Padding="10">
        <DockPanel>
            <!-- Settings problems (D13); collapsed while Notice is null. -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding Notice, Mode=OneWay}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource NoticeForegroundBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Notice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding PlanText, Mode=OneWay}"
                       FontFamily="{StaticResource PlanFontFamily}"
                       Foreground="{StaticResource OverlayForegroundBrush}" />
        </DockPanel>
    </Border>
</Window>
