<Window x:Class="CargoPlan.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CargoPlan.App.ViewModels"
        xmlns:sv="clr-namespace:CargoPlan.App.ShipView"
        xmlns:st="clr-namespace:CargoPlan.App.Settings"
        xmlns:rt="clr-namespace:CargoPlan.App.Routing"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="SC-CargoPlan"
        Width="420" Height="460"
        MinWidth="400" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <!-- Click-through is not set here: it is a mode (IsLocked), switched in code-behind, see D11. -->
    <!-- MinWidth/MinHeight: header, a small ship view and the legend stay visible; restoring saved bounds uses them too.
         MinWidth 400 (D110): per ship its name with the selection's chevron, its own short capacity "N/N +N", gear and exit
         fit the header's first line, the maximum over all ships, in the Windows default message font (Segoe UI 12 px);
         HeaderPanelTests measures it from the shipped baseline. -->
    <Window.Resources>
        <sv:PaletteBrushConverter x:Key="PaletteBrushConverter" />
        <sv:PaletteNoticeConverter x:Key="PaletteNoticeConverter" />
        <sv:LegendCheckedConverter x:Key="LegendCheckedConverter" />
        <sv:LegendMaxHeightConverter x:Key="LegendMaxHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Theme values are DynamicResources from settings.json (ThemeResources, D31), so the settings window can change
             them while the overlay is open (T4.2). A halo that is off has no resource: Effect stays null. -->
        <Style x:Key="LegendTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource LegendFontSize}" />
            <Setter Property="Effect" Value="{DynamicResource LegendHaloEffect}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Notice lines: amber, size and halo of the legend. Only lines with text exist, so nothing needs hiding. -->
        <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource NoticeForegroundBrush}" />
        </Style>
        <!-- Ship name and "All stops delivered.": the header's colour and halo, the window's font size as before. -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
            <Setter Property="Effect" Value="{DynamicResource HeaderHaloEffect}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A legend stop line: the whole line is the button, without box or frame; the hand cursor says it is clickable.
             Delivered is shown by the template's triggers, so the button needs no checked state of its own (D16). -->
        <Style x:Key="LegendLineButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource HitTestBackgroundBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A piece of a legend line or header (K6.1): grey and struck through once its line is delivered. The line's
             ItemsControl carries Delivered in its Tag; the header's carries none, so a header is never struck through. -->
        <Style x:Key="LegendSegmentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DeliveredForegroundBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The reserve lies hidden under the text, so a tick that takes a marking away keeps the line's width (D16, D33).
             Both end in an ellipsis when LegendRowPanel gives them less than they need. -->
        <DataTemplate x:Key="LegendSegmentTemplate" DataType="{x:Type sv:LegendSegment}">
            <Grid>
                <TextBlock Text="{Binding ReserveText, Mode=OneTime}" Style="{StaticResource LegendSegmentTextStyle}" Visibility="Hidden"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Text, Mode=OneTime}" Style="{StaticResource LegendSegmentTextStyle}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <!-- A legend check box (B6, D69): selects crates; a ticked line has no box. Frame and mark (tick and bar) take their own
             colours from the legend's look (K4.1), grey by default.
             Ticked = all selected, a bar = part of them. Three states only with IsThreeState
             (source: https://learn.microsoft.com/dotnet/api/system.windows.controls.primitives.togglebutton.isthreestate);
             the click's own next state doesn't matter, ToggleCratesCommand changes the selection and the binding shows it. -->
        <Style x:Key="LegendCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border BorderBrush="{DynamicResource LegendCheckBoxBrush}" BorderThickness="1.5"
                                Background="{StaticResource HitTestBackgroundBrush}">
                            <Grid>
                                <Path x:Name="Mark" Data="M 1.5,4.5 L 3.8,7 L 7.5,1.5" Stroke="{DynamicResource LegendCheckMarkBrush}"
                                      StrokeThickness="1.5" Visibility="Hidden" />
                                <Rectangle x:Name="Part" Width="5" Height="1.5" Fill="{DynamicResource LegendCheckMarkBrush}" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Part" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "Skip this version" on the update line (T11.2, U3): the legend's box as a two-state check box with its label in
             the notice's amber, size and halo. Checking it removes the line, so it never shows ticked for long. -->
        <Style x:Key="NoticeCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource NoticeForegroundBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource LegendFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="{StaticResource HitTestBackgroundBrush}">
                            <Border Width="12" Height="12" VerticalAlignment="Center" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource LegendCheckBoxBrush}">
                                <Path x:Name="Mark" Data="M 1.5,4.5 L 3.8,7 L 7.5,1.5" Stroke="{DynamicResource LegendCheckMarkBrush}"
                                      StrokeThickness="1.5" Visibility="Hidden" />
                            </Border>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" Effect="{DynamicResource LegendHaloEffect}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The tab strip's tabs (T13.2, D120): the header's colour and halo, background and frame of the buttons (D31), so
             they follow the appearance like every overlay button. Not collapsed while locked: the strip shows where F3 on an
             offer goes; locked, the window is click-through and a click reaches the game, so the selection stays (E2).
             The selected tab is underlined, the other faded: readable over any theme, no colour of its own. -->
        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TabTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>
        <Style x:Key="TabMarkStyle" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="Margin" Value="6,1,6,0" />
            <Setter Property="Background" Value="{DynamicResource HeaderForegroundBrush}" />
            <Setter Property="Effect" Value="{DynamicResource HeaderHaloEffect}" />
        </Style>
        <!-- Glyph buttons in the header (pencil, gear, split, merge, exit): gone while locked, and their room goes to ship name,
             capacity and status (B15, D110): hidden, they kept 210 px, 270 with undo and redo, in the game. -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The header's ship selection (T7.2b): closed it looks like the ship name, with a chevron; the list in the header's
             colours on the window colour without transparency, since it stands over the game. Not focusable, like the
             header buttons: focusing would activate the overlay. Without keyboard focus the closed box ignores the wheel,
             and a selection changes only by a click in the open list or by Enter in the search.
             Open, the name line is the search field (T7.2c, D60): the one place the overlay takes the keyboard. As wide as
             the list and as high as one entry, outlined like the buttons, 2 px above the list.
             Parts: https://learn.microsoft.com/dotnet/desktop/wpf/controls/combobox (PART_Popup, ItemsPresenter in a
             ScrollViewer). Source: dotnet/wpf, PresentationFramework/System/Windows/Controls/ComboBox.cs (OnMouseWheel) -->
        <!-- The slim bar's track above and below the thumb: invisible, but it takes the click that pages. -->
        <Style x:Key="SlimScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The slim bar's thumb: in the bar's Foreground, brighter under the mouse and while dragged. It takes the bar's whole
             width and draws its grip 2 px inside: a press on the inset took nothing and moved the window (K of T13.3a). -->
        <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource HitTestBackgroundBrush}">
                            <Border x:Name="Grip" Margin="2" CornerRadius="2" Opacity="0.35" Background="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A slim bar instead of the system's light grey one, for the ship list and the legend's stop lines (K7) and the
             Plan tab's matrix (T13.2): no arrows, an invisible track that pages on click, a thumb in the Foreground that
             brightens under the mouse. Each user sets Foreground: the header's colour in the list, the legend's in the
             legend and the matrix. Vertical by default; horizontal for the matrix, which scrolls sideways too.
             Parts: https://learn.microsoft.com/dotnet/desktop/wpf/controls/scrollbar (PART_Track) -->
        <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!-- Reversed: a vertical track counts upwards, a scroll bar downwards. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Foreground="{TemplateBinding Foreground}" Style="{StaticResource SlimScrollThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Foreground="{TemplateBinding Foreground}" Style="{StaticResource SlimScrollThumbStyle}" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShipBoxStyle" TargetType="ComboBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="420" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- The capacity in a right-aligned column (F1, Martin's choice over directly behind the name). The header's
                             rule (D67): docked right, and the name as the last child takes what is left and trims. The name gives
                             way, the capacity never. -->
                        <DockPanel MaxWidth="420">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CapacityText, Mode=OneTime}" TextWrapping="NoWrap" Margin="8,0,0,0"
                                       Foreground="{DynamicResource HeaderForegroundBrush}" />
                            <TextBlock Text="{Binding Text, Mode=OneTime}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       Foreground="{DynamicResource HeaderForegroundBrush}" />
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <!-- Ships that didn't load stay visible with their reason (D56), but can't be chosen. Without the
                         automation name a screen reader reads the record's ToString(). -->
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneTime}" />
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable, Mode=OneTime}" />
                        <Setter Property="ToolTip" Value="{Binding Problem, Mode=OneTime}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Grid Background="{StaticResource HitTestBackgroundBrush}">
                                        <Border x:Name="Highlight" Background="{DynamicResource HeaderForegroundBrush}" Opacity="0" />
                                        <ContentPresenter x:Name="Content" Margin="16,2,8,2" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Highlight" Property="Opacity" Value="0.25" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Content" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Opens on press, as the system's box does; the ComboBox closes it again. -->
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <DockPanel Background="{StaticResource HitTestBackgroundBrush}">
                                            <!-- E70D ChevronDown. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="10" Margin="6,4,0,0"
                                                       Foreground="{DynamicResource HeaderForegroundBrush}"
                                                       Effect="{DynamicResource HeaderHaloEffect}" />
                                            <!-- One line: the header's style wraps, and the 30 px header holds two (D67). -->
                                            <TextBlock Text="{Binding Ship.Name, Mode=OneWay}" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource HeaderTextStyle}" />
                                        </DockPanel>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- The search field over the name while the list is open (T7.2c). The text margins are one less
                                 than an entry's, which the outline takes: as high as one entry. Placeholder while empty. -->
                            <Border x:Name="SearchArea" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="{Binding ActualWidth, ElementName=PopupBorder}"
                                    Background="{DynamicResource WindowOpaqueBackgroundBrush}"
                                    BorderBrush="{DynamicResource ButtonsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search ships…" Opacity="0.6" Margin="2,1,8,1"
                                               Visibility="Collapsed" IsHitTestVisible="False"
                                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                                    <TextBox x:Name="ShipSearch" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1,8,1"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource HeaderForegroundBrush}"
                                             CaretBrush="{DynamicResource HeaderForegroundBrush}"
                                             AutomationProperties.Name="Search ships" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border x:Name="PopupBorder" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource WindowOpaqueBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonsBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="0,2">
                                    <!-- By pixels (F2): the theme sets content scrolling on the ComboBox and this viewer takes it over,
                                         which makes the list's StackPanel scroll by its children, the groups: a notch skipped three of
                                         them and the end of a group taller than the list was out of reach. The theme's own template turns
                                         it off when grouping; a template of our own has to as well. All rows exist either way.
                                         Source: dotnet/wpf, Themes/XAML/ComboBox.xaml (MultiTrigger on IsGrouping) and
                                         PresentationFramework/System/Windows/Controls/ScrollViewer.cs (OnPreApplyTemplate) -->
                                    <ScrollViewer CanContentScroll="False">
                                        <ScrollViewer.Resources>
                                            <!-- The slim bar in the header's colour. -->
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="SearchArea" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, ElementName=ShipSearch}" Value="">
                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Locked: hidden like the header buttons; the name shows as text instead (header). -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Text button on the dark overlay: outline in the legend's text colour instead of the system's grey button.
             The outline is its own, not the glyph buttons' frame; background, corners and halo are the buttons' (D31). -->
        <Style x:Key="TextButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource ButtonsBackgroundBrush}"
                                BorderBrush="{DynamicResource LegendForegroundBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource ButtonsCornerRadius}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Effect="{DynamicResource ButtonsHaloEffect}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An update line (T11.2, D109, U1; T12.3 for the ship data): text left in the notices' style, controls right;
             locked, the controls hide and keep their space (U2). One template for the app's line and the ship data's. -->
        <DataTemplate x:Key="UpdateLineTemplate" DataType="{x:Type vm:UpdateViewModel}">
            <DockPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel x:Name="UpdateControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AreControlsShown}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Update" Command="{Binding UpdateCommand}" Style="{StaticResource TextButtonStyle}" Margin="8,0,0,0"
                            Visibility="{Binding ShowsUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Retry" Command="{Binding RetryCommand}" Style="{StaticResource TextButtonStyle}" Margin="8,0,0,0"
                            Visibility="{Binding ShowsRetry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <CheckBox Content="Skip this version" Command="{Binding SkipCommand}" Style="{StaticResource NoticeCheckBoxStyle}" Margin="10,0,0,0"
                              Visibility="{Binding ShowsSkip, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <TextBlock x:Name="UpdateText" Text="{Binding Text, Mode=OneWay}" Style="{StaticResource NoticeTextStyle}" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="4" Padding="10">
        <!-- Named for the stop lines' highest height (K7): a share of this height, which follows the window, not the legend. -->
        <DockPanel x:Name="OverlayContent">
            <!-- Header (B15, D110, revises D67): grip for moving the window (DragMove), later the tab bar (T3.7 notes). The right
                 margin keeps clear of the lock window (36 px at 4 px inset, LockWindowPlacement), so gear and exit always stand
                 next to the padlock. The first line is 30 px high as before; "All stops delivered." sits here, not in the
                 legend (D16). Short of room the status goes first, then the capacity turns short ("0/192 +16"), then the tools
                 move to a second line, left-aligned; the name trims only when it, the short capacity, gear and exit are wider
                 than the window, which MinWidth keeps from happening. Locked, the buttons collapse and the second line goes.
                 No background, so free room still moves the window. No IsLocked trigger on the capacities: information, not a
                 control, they stay while locked. -->
            <sv:HeaderPanel DockPanel.Dock="Top" LineHeight="30" Margin="0,0,30,0">
                <!-- The ship selection sits on the ship name, where haulers look for it (T7.2b, D59). Locked: the name as
                     text, like the hidden buttons. -->
                <Grid sv:HeaderPanel.Part="Name" VerticalAlignment="Top">
                    <Grid.Resources>
                        <!-- Grouped in the order of first appearance; ShipChoices.Of sorts. OneWay: Recent changes with the ship (T7.2c). -->
                        <CollectionViewSource x:Key="ShipsView" Source="{Binding ShipSelection, Mode=OneWay}">
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="Group" />
                            </CollectionViewSource.GroupDescriptions>
                        </CollectionViewSource>
                    </Grid.Resources>
                    <ComboBox x:Name="ShipBox" Style="{StaticResource ShipBoxStyle}"
                              ItemsSource="{Binding Source={StaticResource ShipsView}}"
                              ToolTip="Your ship. Click to change it; a plan is planned anew for the new ship."
                              IsSynchronizedWithCurrentItem="False"
                              DropDownOpened="OnShipListOpened" DropDownClosed="OnShipListClosed"
                              SelectionChanged="OnShipSelectionChanged">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,6,8,2"
                                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <TextBlock Text="{Binding Ship.Name, Mode=OneWay}"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="CapacityText" sv:HeaderPanel.Part="Capacity"
                           Text="{Binding Scene.CapacityText, Mode=OneWay}"
                           ToolTip="{Binding Scene.CapacityToolTip, Mode=OneWay}"
                           TextWrapping="NoWrap"
                           Margin="8,0,0,0"
                           Style="{StaticResource HeaderTextStyle}" />
                <TextBlock x:Name="CompactCapacityText" sv:HeaderPanel.Part="CompactCapacity"
                           Text="{Binding Scene.CompactCapacityText, Mode=OneWay}"
                           ToolTip="{Binding Scene.CapacityToolTip, Mode=OneWay}"
                           TextWrapping="NoWrap"
                           Margin="8,0,0,0"
                           Style="{StaticResource HeaderTextStyle}" />
                <!-- At the right end, next to the buttons, where it stood before; its words stay in the capacity's tool tip. -->
                <TextBlock sv:HeaderPanel.Part="Status"
                           Text="{x:Static sv:ShipScene.AllDeliveredText}"
                           VerticalAlignment="Top"
                           TextWrapping="NoWrap"
                           Margin="6,0,0,0"
                           Foreground="{StaticResource DeliveredForegroundBrush}"
                           Effect="{DynamicResource HeaderHaloEffect}"
                           Visibility="{Binding Scene.AllDelivered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!-- The tool buttons, left to right as they stand (D34: plan controls left of the window controls). Short of
                     room they move to a second line, left-aligned, in the same order (D110). -->
                <StackPanel sv:HeaderPanel.Part="Tools" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Merge and split the selected crates when the kiosk delivered others than planned (D27); left of the re-plan button,
                         hidden while locked like it. Disabled, the tool tip says why (ShowOnDisabled).
                         Source: https://learn.microsoft.com/dotnet/api/system.windows.controls.tooltipservice.showondisabled -->
                    <Button Command="{Binding SplitCommand, Mode=OneTime}" ToolTip="{Binding SplitToolTip}"
                            ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E8C6 Cut. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                    <Button Command="{Binding MergeCommand, Mode=OneTime}" ToolTip="{Binding MergeToolTip}"
                            ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E71B Link. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                    <!-- Re-plan (D66) between the pencil and merge, Martin's choice after B4: also here, not only in the editor.
                         It asks first (ConfirmDialog), then the notice line says what happened; disabled, the tool tip says why,
                         like split and merge. -->
                    <Button Command="{Binding ReplanCommand, Mode=OneTime}" ToolTip="{Binding ReplanToolTip}"
                            ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E72C Refresh. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                    <!-- Opens the mission editor, left of the gear. Locked it is gone like every header button (T3.7 notes, D110):
                         planning is a step with a free cursor, and a locked overlay is click-through anyway. -->
                    <Button ToolTip="Enter missions" Click="OnOpenEditor" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E70F Edit. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                    <!-- Undo and redo (K2.4) left of the reset, ↶ ↷: each only while there is a step for it (the border collapses),
                         hidden while locked like every header button (the button's style keeps that, a local Visibility on the
                         button would override its trigger). -->
                    <Border Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding UndoCommand, Mode=OneTime}" ToolTip="Undo" Style="{StaticResource HeaderButtonStyle}">
                            <!-- E7A7 Undo. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                       Foreground="{DynamicResource HeaderForegroundBrush}" />
                        </Button>
                    </Border>
                    <Border Visibility="{Binding CanRedo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding RedoCommand, Mode=OneTime}" ToolTip="Redo" Style="{StaticResource HeaderButtonStyle}">
                            <!-- E7A6 Redo. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                            <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                       Foreground="{DynamicResource HeaderForegroundBrush}" />
                        </Button>
                    </Border>
                    <!-- Reset view (K1.3) at the tools' right end, next to the gear on one line, like a double-click next to the
                         cargo: a view control, so right of the plan's undo and redo (D34); they come and go further left, so it
                         never jumps sideways. On a second line it goes along with the tools (D110). Always there, gone while
                         locked like every header button. -->
                    <Button Command="{Binding ResetViewCommand, Mode=OneTime}" ToolTip="Reset view" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E9A6 FitPage. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE9A6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                </StackPanel>
                <!-- Gear and exit: the window controls stay at the right end of the first line, next to the padlock (D110). -->
                <StackPanel sv:HeaderPanel.Part="Chrome" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Opens the settings window, left of the exit button: window controls right, plan controls left of them (D34).
                         Hidden while locked like every header button. Over an invisible theme the system tool tip still finds
                         it: the button background keeps alpha 1, so it takes the hover (user guide, "Overlay unreadable?"). -->
                    <Button ToolTip="Settings" Click="OnOpenSettings" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E713 Setting. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                    <!-- Exits the app, next to the padlock, without a dialog: closes the overlay like the taskbar does, so its
                         Closed handlers write what is pending (bounds, settings, plan). Hidden while locked like every header
                         button (D34, addendum T5.1). -->
                    <Button ToolTip="Exit" Click="OnExit" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E8BB ChromeClose. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                </StackPanel>
            </sv:HeaderPanel>

            <!-- Tab strip "Cargo | Plan" (T13.2, D120): a line of its own under the header, not a part of it, so the header's
                 rules stay (D110: the name never trims, the tools wrap to a second line that goes while locked). Left-aligned;
                 the free room right of it moves the window, as the header's does. Plan is the Routes tab (K1 of the T13.2
                 approval): IsRoutesTabSelected, kept in settings.json as routes.tab. -->
            <StackPanel x:Name="TabStrip" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,0">
                <Button x:Name="CargoTab" Command="{Binding ShowCargoCommand, Mode=OneTime}" Style="{StaticResource TabButtonStyle}"
                        ToolTip="Cargo: what goes on which rack of the ship">
                    <StackPanel>
                        <TextBlock Text="Cargo">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabMarkStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="PlanTab" Command="{Binding ShowPlanCommand, Mode=OneTime}" Style="{StaticResource TabButtonStyle}"
                        ToolTip="Plan: which contracts go from where to where. F3 on an offer only notes it here; the cargo stays as it is.">
                    <StackPanel>
                        <TextBlock Text="Plan">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabTextStyle}">
                                    <Setter Property="Opacity" Value="0.55" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabMarkStyle}">
                                    <Setter Property="Visibility" Value="Hidden" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- The ship data line (T12.3, D112): the bottom line, below the update line, the same template. -->
            <ContentControl x:Name="ShipDataLine" DockPanel.Dock="Bottom" Focusable="False" Content="{Binding ShipData, Mode=OneWay}"
                            ContentTemplate="{StaticResource UpdateLineTemplate}" />
            <!-- The update line (T11.2, D109, U1): below the notices (the earlier of two bottom children lies lower), above
                 the ship data line. No line without an update: Update is null outside the overlay's start, IsVisible false
                 without an offer. -->
            <ContentControl x:Name="UpdateLine" DockPanel.Dock="Bottom" Focusable="False" Content="{Binding Update, Mode=OneWay}"
                            ContentTemplate="{StaticResource UpdateLineTemplate}" />
            <!-- Problems with settings (D13), hotkeys (D17) and the plan file, one line per source (D18). The bottom lines,
                 only the update line below them; full width and left-aligned, wherever the legend stands (D33, addendum
                 T5.1): docked before the legend area, so a bottom legend stands above it, and a notice coming and going never
                 moves a top legend or the ship view's top edge. Inside the aligned block a long notice would widen it and
                 move the stop lines. -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource NoticeTextStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Legend area (D33): below the ship view or between header and view, switched live through the view model
                 (T4.2), not built once at startup. Before the ship view, which stays the last child and fills the rest.
                 Changing DockPanel.Dock re-measures the parent DockPanel (OnDockChanged → InvalidateMeasure).
                 Source: https://github.com/dotnet/wpf/blob/main/src/Microsoft.DotNet.Wpf/src/PresentationFramework/System/Windows/Controls/DockPanel.cs -->
            <DockPanel x:Name="LegendArea">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LegendPosition.Edge}" Value="{x:Static st:LegendEdge.Top}">
                                <Setter Property="DockPanel.Dock" Value="Top" />
                            </DataTrigger>
                            <!-- The Plan tab (D120) takes the room of legend and ship view. -->
                            <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- Legend: one line per stop, then violations (red racks) and planner hints, word for word (D7).
                     A click on a stop line ticks it off or back (D16, addendum T3.8b: a plain line, no check box); a right drag of
                     a stop line into the ship view moves the whole stop to the rack under the cursor (D25). The lines
                     are buttons and handle their left clicks, so DragMove works on the header, the lines below the stops and the border,
                     not on the stop lines.
                     A block as wide as its lines, left, centred or right as a whole; inside, everything stays left-aligned, so
                     the swatches stand in one column (D33). The hidden hint reserve counts towards its width and height, so
                     ticking moves neither the block nor the ship view in any position (D16). The gap faces the ship view. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,6,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LegendPosition.Edge}" Value="{x:Static st:LegendEdge.Top}">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LegendPosition.Alignment}" Value="{x:Static st:LegendAlignment.Center}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LegendPosition.Alignment}" Value="{x:Static st:LegendAlignment.Right}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- The route's station bar (T13.6 6b, U9.3, D126): one line above the block "Plan", outside the scroll so
                         it never scrolls away: ‹ and › by hand (the ticks move it too), "Finish plan" at the hub at the end;
                         under it the ways back of its stop (fits / too big in the notice colour) and the ones collecting there.
                         Only with a route; the buttons take no focus (U7). -->
                    <StackPanel x:Name="StationBar" DataContext="{Binding ActiveRoute}" Margin="0,0,0,4"
                                Visibility="{Binding HasRoute, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <Button x:Name="PreviousStationButton" DockPanel.Dock="Left" Content="‹" Command="{Binding PreviousStationCommand}" Focusable="False"
                                    Style="{StaticResource TextButtonStyle}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="One stop back" />
                            <Button x:Name="FinishPlanButton" DockPanel.Dock="Right" Content="Finish plan" Command="{Binding FinishPlanCommand}" Focusable="False"
                                    Style="{StaticResource TextButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsAtEnd, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="Finish the plan: the round's aUEC and time are kept, the placeholders go, the cargo stays." />
                            <Button x:Name="NextStationButton" DockPanel.Dock="Right" Content="›" Command="{Binding NextStationCommand}" Focusable="False"
                                    Style="{StaticResource TextButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="One stop on" />
                            <TextBlock Text="{Binding StationText}" ToolTip="{Binding StationToolTip}" Style="{StaticResource LegendTextStyle}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding StationRows}" Focusable="False" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type rt:PlaceholderRowView}">
                                    <TextBlock x:Name="Line" ToolTip="{Binding ToolTip}" Style="{StaticResource LegendTextStyle}" Opacity="0.6"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding Accept, Mode=OneWay}" Foreground="{StaticResource NoticeForegroundBrush}" /><Run Text="{Binding Collect, Mode=OneWay}" /></TextBlock>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Filled}" Value="True">
                                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Hidden by legend.visible = false: only the stop lines go (D33). Warnings and the empty state stay,
                         notices are at the bottom anyway; a stop is then ticked in the ship view and moved through the crate selection.
                         The lines scroll beyond their share of the overlay (K7, D80); what follows them never scrolls. No
                         horizontal range: the lines get the width, so they shorten (K6.1). Not focusable: a focus would
                         activate the overlay, and a ScrollViewer that takes the focus handles the left click DragMove needs.
                         The route's block "Plan" (T13.6) is the first thing in it, so it scrolls with the lines; it stays
                         with legend.visible = false, so the scroll does too while a route is on.
                         Source: dotnet/wpf, PresentationFramework/System/Windows/Controls/ScrollViewer.cs (OnMouseLeftButtonDown) -->
                    <ScrollViewer x:Name="StopLinesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ScrollViewer.MaxHeight>
                            <MultiBinding Converter="{StaticResource LegendMaxHeightConverter}" Mode="OneWay">
                                <Binding ElementName="OverlayContent" Path="ActualHeight" Mode="OneWay" />
                                <Binding Path="LegendMaxHeightShare" Mode="OneWay" />
                            </MultiBinding>
                        </ScrollViewer.MaxHeight>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <!-- Without ActiveRoute (tests) the fallback says no route. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLegendVisible}" Value="False" />
                                            <Condition Binding="{Binding ActiveRoute.HasRoute, FallbackValue=False}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ScrollViewer.Resources>
                            <!-- The slim bar in the legend's colour. -->
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel>
                        <!-- The route's block "Plan" (T13.6, U9.1, D125): a head with "End plan", one line per placeholder in the
                             legend's look, open ones grey, filled ones "✓ #3 · …" in full; the ways back under "Back", greyer;
                             the extras last. No crates in the ship for a placeholder. Only with a route. -->
                        <StackPanel x:Name="RouteBlock" DataContext="{Binding ActiveRoute}" Margin="0,0,0,6"
                                    Visibility="{Binding HasRoute, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <DockPanel>
                                <Button x:Name="EndPlanButton" DockPanel.Dock="Right" Content="End plan" Command="{Binding EndCommand}" Focusable="False"
                                        Style="{StaticResource TextButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="End the plan: its placeholders go, the cargo stays." />
                                <!-- Gate 6b: the head folds the lines below (▾ open, ▸ closed); a legend line's button, no new
                                     element. Start plan opens them, the first departure closes them, the state is kept (routes.planBlock). -->
                                <Button x:Name="RouteBlockHead" Command="{Binding ToggleBlockCommand}" ToolTip="{Binding HeaderToolTip}" Focusable="False"
                                        Style="{StaticResource LegendLineButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource LegendTextStyle}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                </Button>
                            </DockPanel>
                            <StackPanel x:Name="RouteBlockList" Visibility="{Binding IsBlockOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type rt:PlaceholderRowView}">
                                        <!-- Gate 6a: wraps, so places and "collect at" read whole (K1); "accept at" in the
                                             status line's orange (K3). The runs stand on one line: a break between them would be a space. -->
                                        <TextBlock x:Name="Line" ToolTip="{Binding ToolTip}" Style="{StaticResource LegendTextStyle}" Opacity="0.6"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding Accept, Mode=OneWay}" Foreground="{StaticResource NoticeForegroundBrush}" /><Run Text="{Binding Collect, Mode=OneWay}" /></TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Filled}" Value="True">
                                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Back" Style="{StaticResource LegendTextStyle}" Opacity="0.45" Margin="0,2,0,0"
                                       Visibility="{Binding HasBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding BackRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type rt:PlaceholderRowView}">
                                        <TextBlock x:Name="Line" ToolTip="{Binding ToolTip}" Style="{StaticResource LegendTextStyle}" Opacity="0.45"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding Accept, Mode=OneWay}" Foreground="{StaticResource NoticeForegroundBrush}" /><Run Text="{Binding Collect, Mode=OneWay}" /></TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Filled}" Value="True">
                                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ExtraRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource LegendTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- E1 of gate 6a: a faint line parts the block from the stop lines below. -->
                            </StackPanel>
                            <Border x:Name="RouteSeparator" Height="1" Margin="0,6,0,0" Opacity="0.4" Background="{DynamicResource LegendForegroundBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Scene.Legend, Mode=OneWay}"
                                      Visibility="{Binding IsLegendVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <!-- The command replaces the plan, so the legend is rebuilt and the grey comes from the new entry. -->
                                <DataTemplate DataType="{x:Type sv:LegendEntry}">
                                    <!-- "From A, B" or "From ?" over the first line of a mission once any mission has a pickup (B6,
                                         D69): no tick of its own, it goes with the lines when the legend is hidden (D33). Its check box
                                         selects the mission's crates on board, a right drag of the header moves them. Each line has a
                                         check box of its own for its crates, outside the line's button: a click on the box selects, a
                                         click on the line ticks, a right drag of the line moves its crates. A box shows ticked while all
                                         its crates are selected, a bar for part (LegendCheckedConverter). -->
                                    <StackPanel>
                                        <!-- Rows are DockPanels, not horizontal StackPanels: those measure their children at infinite
                                             width, and the text could never shorten (K6.1). The tool tip holds the whole text. -->
                                        <DockPanel x:Name="HeaderRow" Background="{StaticResource HitTestBackgroundBrush}"
                                                   MouseRightButtonDown="OnLegendHeaderRightButtonDown" ToolTip="{Binding HeaderLabel, Mode=OneTime}">
                                            <CheckBox x:Name="MissionCheck" DockPanel.Dock="Left" Style="{StaticResource LegendCheckBoxStyle}"
                                                      Command="{Binding DataContext.ToggleCratesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding MissionCrates, Mode=OneTime}">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource LegendCheckedConverter}" Mode="TwoWay">
                                                        <Binding Path="MissionCrates" Mode="OneWay" />
                                                        <Binding Path="DataContext.Selection" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.Scene" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                            <!-- "From Lorville" · " · #47": the pickups shorten, the contract's number never (K6.1). -->
                                            <ItemsControl x:Name="HeaderText" ItemsSource="{Binding HeaderSegments, Mode=OneTime}"
                                                          ItemTemplate="{StaticResource LegendSegmentTemplate}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <sv:LegendRowPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="sv:LegendRowPanel.Rank" Value="{Binding Rank, Mode=OneTime}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </DockPanel>
                                        <DockPanel x:Name="LineRow">
                                            <CheckBox x:Name="LineCheck" DockPanel.Dock="Left" Style="{StaticResource LegendCheckBoxStyle}"
                                                      Command="{Binding DataContext.ToggleCratesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding Crates, Mode=OneTime}">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource LegendCheckedConverter}" Mode="TwoWay">
                                                        <Binding Path="Crates" Mode="OneWay" />
                                                        <Binding Path="DataContext.Selection" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.Scene" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                            <!-- A click ticks this line, one mission's crates for one destination (B6, D69); a click on a
                                                 crate in the ship view ticks the whole stop. -->
                                            <Button x:Name="LineButton"
                                                    Command="{Binding DataContext.ToggleLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Mode=OneTime}"
                                                    Style="{StaticResource LegendLineButtonStyle}"
                                                    MouseRightButtonDown="OnLegendRightButtonDown"
                                                    ToolTip="{Binding Label, Mode=OneTime}">
                                                <DockPanel x:Name="LineContent">
                                                    <!-- The stop's ordinal and the overlay's palette, the brush the view paints its
                                                         crates with, hatch included (K4.2). -->
                                                    <Rectangle x:Name="Swatch" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0">
                                                        <Rectangle.Fill>
                                                            <MultiBinding Converter="{StaticResource PaletteBrushConverter}" Mode="OneWay">
                                                                <Binding Path="PaletteIndex" Mode="OneTime" />
                                                                <Binding Path="DataContext.StopPalette" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- "To Green Glade Station" · " · 5 SCU (4+1)" · " · Pressurized Ice" · markings (K6.1):
                                                         the commodity shortens first, then the destination; quantity, mix and markings never.
                                                         The markings carry the reserve, so a tick keeps the line's width (D16, D33). The Tag
                                                         tells the segments that the line is delivered (LegendSegmentTextStyle). -->
                                                    <ItemsControl x:Name="LineText" ItemsSource="{Binding Segments, Mode=OneTime}" Tag="{Binding Delivered, Mode=OneTime}"
                                                                  ItemTemplate="{StaticResource LegendSegmentTemplate}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <sv:LegendRowPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="sv:LegendRowPanel.Rank" Value="{Binding Rank, Mode=OneTime}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </StackPanel>
                                    <!-- Template triggers outrank values set in the template, so the grey wins over the bound colour.
                                         Hidden, not collapsed, boxes keep their column, so swatches and headers stay aligned.
                                         Source: https://learn.microsoft.com/dotnet/desktop/wpf/properties/dependency-property-value-precedence -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Header}" Value="{x:Null}">
                                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MissionCrates}" Value="{x:Null}">
                                            <Setter TargetName="MissionCheck" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Grouped}" Value="True">
                                            <Setter TargetName="LineRow" Property="Margin" Value="18,0,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Delivered}" Value="True">
                                            <Setter TargetName="LineCheck" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Swatch" Property="Fill" Value="{x:Static sv:MissionPalette.DeliveredBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Empty state: the sentence and a second way into the editor besides the pencil. After the lines, so the
                         route's block (T13.6) stands above it; without a route the lines are empty then and nothing moves. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlan}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static vm:OverlayViewModel.NoPlanText}" Style="{StaticResource LegendTextStyle}" />
                        <Button Content="Open editor" Click="OnOpenEditor" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Style="{StaticResource TextButtonStyle}" />
                    </StackPanel>
                    <!-- Missions that didn't fit (D41): a hollow swatch, the reason, and a click drops the mission. Shown even
                         with legend.visible = false, like the warnings: they ask for something (T5.4). -->
                    <ItemsControl ItemsSource="{Binding Scene.Unplaced, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sv:UnplacedEntry}">
                                <Button Command="{Binding DataContext.DropMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding MissionId, Mode=OneTime}"
                                        Style="{StaticResource LegendLineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Margin="0,0,6,0" Fill="Transparent"
                                                   Stroke="{DynamicResource LegendForegroundBrush}" StrokeThickness="1" />
                                        <TextBlock Text="{Binding Label, Mode=OneTime}" Style="{StaticResource LegendTextStyle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Scene.Violations, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource LegendTextStyle}"
                                           Foreground="{x:Static sv:MissionPalette.ViolationBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- More stops than colours, from the stop count and the palette (K4.2): empty, and collapsed, while none repeat. -->
                    <TextBlock x:Name="PaletteNotice">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource PaletteNoticeConverter}" Mode="OneWay">
                                <Binding Path="Scene.StopCount" Mode="OneWay" />
                                <Binding Path="StopPalette" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Last child fills the rest. Left drag here orbits, a click on cargo ticks its stop, right drag on a crate
                 puts it on the cell under the cursor, right drag elsewhere pans; DragMove works on header, warning lines and border.
                 The hologram is part of the ship view's 3D scene (D83): crates inside the hull show through it.
                 With the Plan tab selected (D120) the ship view is collapsed, so its Viewport3D draws nothing, and the plan's
                 content takes its room and the legend's. -->
            <Grid>
                <!-- The Plan tab's content (T13.2): the port matrix (design §8.5) of the Routes view model. The filter's parts are
                     buttons that cycle (click: next, right click: back), in the legend's colours: no popups over the game and no
                     look of their own. The matrix scrolls both ways; text in the legend's size, colour and halo. Without hauling
                     data one sentence and nothing else (K2: in the tab, never as a notice). -->
                <ContentControl x:Name="PlanView" Focusable="False" Content="{Binding Routes, Mode=OneTime}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type rt:RoutesViewModel}">
                            <DockPanel Margin="0,6,0,0">
                                <DockPanel.Resources>
                                    <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
                                        <Setter Property="Margin" Value="0,0,4,4" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Click: next · right click: back" />
                                    </Style>
                                    <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="Effect" Value="{x:Null}" />
                                    </Style>
                                    <Style x:Key="SizeCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource NoticeCheckBoxStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                                        <Setter Property="Margin" Value="0,0,8,4" />
                                    </Style>
                                    <Style x:Key="{x:Static rt:PortMatrixGrid.CellTextStyleKey}" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="Margin" Value="6,2,6,2" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                    <Style x:Key="{x:Static rt:PortMatrixGrid.PickupTextStyleKey}" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                        <Setter Property="Margin" Value="0,2,8,2" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <!-- Long station names would take the default overlay's width; the full name in the tool tip. -->
                                        <Setter Property="MaxWidth" Value="150" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Pickup}" />
                                    </Style>
                                    <!-- The matrix's scroll bars in both directions: the overlay's slim bar in the legend's colour. -->
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                                    </Style>
                                    <!-- A loop's row (T13.4): the whole row a click target without a look of its own; a Stanton hub's row
                                         shows its recipe (hand cursor), a row that needs scans is faint. The row clicked last carries a
                                         bar on its left: "Start plan" starts it (T13.6, K4). Hand, bar and faint are the row's only looks. -->
                                    <Style x:Key="LoopRowStyle" TargetType="Button">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource LegendForegroundBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanOpen}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Chosen}" Value="True">
                                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                                <Setter Property="Padding" Value="4,0,0,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Grey}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="BlockIfTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Resources>

                                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText, Mode=OneTime}" Style="{StaticResource BlockIfTextStyle}" />

                                <!-- Filter (one model for matrix and map, T13.7): rank, faction and hub are kept in settings.json. The
                                     view button switches matrix, recipe (T13.3b), loops (T13.4) and map (T13.7); the hub only counts
                                     for the recipe, the sort and the times for the loops, the filters from area on for the matrix and
                                     the map, which draws the matrix's cells, so each shows with its view. -->
                                <WrapPanel DockPanel.Dock="Top" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneTime}">
                                    <Button Command="{Binding NextCommand}" CommandParameter="view" Style="{StaticResource FilterButtonStyle}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="view" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding ViewLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="hub" Style="{StaticResource FilterButtonStyle}"
                                            Visibility="{Binding IsRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="hub" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding HubLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="sort" Style="{StaticResource FilterButtonStyle}"
                                            Visibility="{Binding IsLoops, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="sort" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding SortLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="rank" Style="{StaticResource FilterButtonStyle}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="rank" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding RankLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="system" Style="{StaticResource FilterButtonStyle}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="system" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding SystemLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <!-- T13.6 (K4): the route of the row clicked last, else the top row (loops) or the hub's ring
                                         (recipe); its tool tip says which, also while it can't start. Right of the system (gate 6a). -->
                                    <Button x:Name="StartPlanButton" Command="{Binding StartPlanCommand}" Style="{StaticResource FilterButtonStyle}"
                                            ToolTip="{Binding StartPlanToolTip}" ToolTipService.ShowOnDisabled="True"
                                            Visibility="{Binding OffersStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Start plan" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="area" Style="{StaticResource FilterButtonStyle}" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="area" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding AreaLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="direct" Style="{StaticResource FilterButtonStyle}" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="direct" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding DirectLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="contractor" Style="{StaticResource FilterButtonStyle}" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="contractor" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding ContractorLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <Button Command="{Binding NextCommand}" CommandParameter="faction" Style="{StaticResource FilterButtonStyle}" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.InputBindings>
                                            <MouseBinding Gesture="RightClick" Command="{Binding PreviousCommand}" CommandParameter="faction" />
                                        </Button.InputBindings>
                                        <TextBlock Text="{Binding FactionLabel}" Style="{StaticResource FilterLabelStyle}" />
                                    </Button>
                                    <CheckBox Content="XS" IsChecked="{Binding ShowXs}" Style="{StaticResource SizeCheckBoxStyle}" ToolTip="Extra small" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="S" IsChecked="{Binding ShowSmall}" Style="{StaticResource SizeCheckBoxStyle}" ToolTip="Small" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="M" IsChecked="{Binding ShowMedium}" Style="{StaticResource SizeCheckBoxStyle}" ToolTip="Medium" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="L" IsChecked="{Binding ShowLarge}" Style="{StaticResource SizeCheckBoxStyle}" ToolTip="Large" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="B" IsChecked="{Binding ShowBulk}" Style="{StaticResource SizeCheckBoxStyle}" ToolTip="Bulk" Visibility="{Binding ShowsMatrixFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding TimesText}" ToolTip="{Binding TimesToolTip, Mode=OneTime}" Style="{StaticResource FilterLabelStyle}"
                                               VerticalAlignment="Center" Margin="2,0,0,4"
                                               Visibility="{Binding IsLoops, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>

                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding WithoutPlaceText}" Style="{StaticResource BlockIfTextStyle}" Margin="0,4,0,0" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding RegionsText}" Style="{StaticResource BlockIfTextStyle}" Margin="0,2,0,0" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MapNote}" Style="{StaticResource BlockIfTextStyle}" Margin="0,2,0,0" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding MapLegend, Mode=OneTime}" Style="{StaticResource BlockIfTextStyle}"
                                           Visibility="{Binding ShowsMap, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Legend, Mode=OneTime}" Style="{StaticResource BlockIfTextStyle}"
                                           Visibility="{Binding ShowsMatrix, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource BlockIfTextStyle}" />

                                <Grid>
                                    <!-- The recipe (T13.3b, D123): a list in the legend's look, one line per role, the sum below; a hint,
                                         nothing to click. Scrolls like the stop lines (no focus, so the left click still moves the window). -->
                                    <ScrollViewer x:Name="RecipeView" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding ShowsRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RecipeNote}" Style="{StaticResource BlockIfTextStyle}" />
                                            <ItemsControl ItemsSource="{Binding RecipeLines}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource LegendTextStyle}" Margin="0,0,0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding RecipeSummary}" Style="{StaticResource BlockIfTextStyle}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
    
                                    <!-- The loops (T13.4, D124): one row per loop in the legend's look, best first by the sort; a click on a
                                         Stanton hub's row shows its recipe. Scrolls like the recipe. -->
                                    <ScrollViewer x:Name="LoopsView" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding ShowsLoops, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LoopsNote}" Style="{StaticResource BlockIfTextStyle}" />
                                            <ItemsControl x:Name="LoopRows" ItemsSource="{Binding LoopRows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type rt:LoopRowView}">
                                                        <Button Style="{StaticResource LoopRowStyle}" ToolTip="{Binding ToolTip}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.OpenLoopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource LegendTextStyle}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Figures}" Style="{StaticResource BlockIfTextStyle}" Margin="0" />
                                                                <TextBlock Text="{Binding Details}" Style="{StaticResource LegendTextStyle}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- The map (T13.7, D128): the matrix's cells as a graph over the system, in the legend's colours and
                                         the stop palette; it takes the wheel (zoom) and a left drag on free room (pan), so free room here
                                         doesn't move the window. Locked, the window is click-through (D11). -->
                                    <!-- T13.7b (D129): the custom route clicked on the map above it, in the recipe's look; "Clear" drops
                                         it, "Start plan" in the filter row starts it. -->
                                    <DockPanel x:Name="MapView" Visibility="{Binding ShowsMap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel x:Name="CustomBar" DockPanel.Dock="Top"
                                                    Visibility="{Binding HasCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <DockPanel>
                                                <Button x:Name="ClearCustomButton" DockPanel.Dock="Right" Command="{Binding ClearCustomCommand}" Style="{StaticResource FilterButtonStyle}"
                                                        ToolTip="Drop your plan; the station in focus stays" VerticalAlignment="Top">
                                                    <TextBlock Text="Clear" Style="{StaticResource FilterLabelStyle}" />
                                                </Button>
                                                <TextBlock Text="{Binding CustomSummary}" Style="{StaticResource BlockIfTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding CustomLines}" Focusable="False" Margin="0,0,0,4">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource LegendTextStyle}" Margin="0,0,0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <rt:RouteMapView x:Name="RouteMap" Scene="{Binding Map}" FocusCommand="{Binding FocusCommand}"
                                                         AddEdgeCommand="{Binding AddEdgeCommand}" RemoveEdgeCommand="{Binding RemoveEdgeCommand}"
                                                         Palette="{Binding DataContext.StopPalette, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DockPanel>

                                    <!-- The matrix: pickups down, drop-offs across, the pickup column frozen; read only, no selection look. -->
                                    <DataGrid x:Name="PortMatrix" rt:PortMatrixGrid.Columns="{Binding Columns}" ItemsSource="{Binding Rows}"
                                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FrozenColumnCount="1"
                                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False"
                                              CanUserSortColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="Cell"
                                              GridLinesVisibility="None" Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource LegendForegroundBrush}" FontSize="{DynamicResource LegendFontSize}"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                                              Visibility="{Binding ShowsMatrix, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="6,0,6,4" />
                                                <Setter Property="VerticalContentAlignment" Value="Bottom" />
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="100" Effect="{DynamicResource HeaderHaloEffect}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <Grid x:Name="CargoView">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoutesTabSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- One selected crate: pickup · commodity · destination (T7.4d). Over the view, not above it: a line that came
                         and went with the selection would refit the ship under the cursor. Never hit, so the view keeps the mouse. -->
                    <TextBlock Text="{Binding SelectionInfo, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectionInfo}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <sv:ShipViewControl x:Name="ShipView"
                                        Scene="{Binding Scene, Mode=OneWay}"
                                        ToggleStopCommand="{Binding ToggleDeliveredCommand, Mode=OneTime}"
                                        MoveCratesCommand="{Binding MoveCratesCommand, Mode=OneTime}"
                                        MoveLegendCommand="{Binding MoveLegendCommand, Mode=OneTime}"
                                        Selection="{Binding Selection}"
                                        MaxPxPerCell="{Binding MaxZoomPxPerCell, Mode=OneWay}"
                                        StopPalette="{Binding StopPalette, Mode=OneWay}"
                                        Camera="{Binding Camera}"
                                        Holo="{Binding Holo, Mode=OneWay}"
                                        HoloOpacity="{Binding HoloOpacity, Mode=OneWay}"
                                        HoloHullColor="{Binding HoloHullColor, Mode=OneWay}"
                                        HoloEdgeColor="{Binding HoloEdgeColor, Mode=OneWay}"
                                        CrateFillAlpha="{DynamicResource CratesFillAlpha}"
                                        CrateEdgeBrush="{DynamicResource CratesEdgeBrush}"
                                        RackNumberBrush="{DynamicResource CratesRackNumberBrush}"
                                        RackNumberFontSize="{DynamicResource CratesRackNumberFontSize}"
                                        RackNumberHaloBrush="{DynamicResource CratesHaloBrush}"
                                        RackNumberHaloSize="{DynamicResource CratesHaloSize}"
                                        SelectionPen="{DynamicResource CratesSelectionPen}"
                                        SelectionOutlinePen="{DynamicResource CratesSelectionOutlinePen}" />
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
