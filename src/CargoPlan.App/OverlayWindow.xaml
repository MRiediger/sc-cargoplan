<Window x:Class="CargoPlan.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CargoPlan.App.ViewModels"
        xmlns:sv="clr-namespace:CargoPlan.App.ShipView"
        xmlns:st="clr-namespace:CargoPlan.App.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:OverlayViewModel}"
        Title="SC-CargoPlan"
        Width="420" Height="460"
        MinWidth="240" MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <!-- Click-through is not set here: it is a mode (IsLocked), switched in code-behind, see D11. -->
    <!-- MinWidth/MinHeight: header, a small ship view and the legend stay visible; restoring saved bounds uses them too. -->
    <Window.Resources>
        <sv:PaletteBrushConverter x:Key="PaletteBrushConverter" />
        <sv:PaletteNoticeConverter x:Key="PaletteNoticeConverter" />
        <sv:LegendCheckedConverter x:Key="LegendCheckedConverter" />
        <sv:LegendMaxHeightConverter x:Key="LegendMaxHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Theme values are DynamicResources from settings.json (ThemeResources, D31), so the settings window can change
             them while the overlay is open (T4.2). A halo that is off has no resource: Effect stays null. -->
        <Style x:Key="LegendTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource LegendFontSize}" />
            <Setter Property="Effect" Value="{DynamicResource LegendHaloEffect}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Notice lines: amber, size and halo of the legend. Only lines with text exist, so nothing needs hiding. -->
        <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource NoticeForegroundBrush}" />
        </Style>
        <!-- Ship name and "All stops delivered.": the header's colour and halo, the window's font size as before. -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
            <Setter Property="Effect" Value="{DynamicResource HeaderHaloEffect}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- A legend stop line: the whole line is the button, without box or frame; the hand cursor says it is clickable.
             Delivered is shown by the template's triggers, so the button needs no checked state of its own (D16). -->
        <Style x:Key="LegendLineButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource HitTestBackgroundBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A piece of a legend line or header (K6.1): grey and struck through once its line is delivered. The line's
             ItemsControl carries Delivered in its Tag; the header's carries none, so a header is never struck through. -->
        <Style x:Key="LegendSegmentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DeliveredForegroundBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The reserve lies hidden under the text, so a tick that takes a marking away keeps the line's width (D16, D33).
             Both end in an ellipsis when LegendRowPanel gives them less than they need. -->
        <DataTemplate x:Key="LegendSegmentTemplate" DataType="{x:Type sv:LegendSegment}">
            <Grid>
                <TextBlock Text="{Binding ReserveText, Mode=OneTime}" Style="{StaticResource LegendSegmentTextStyle}" Visibility="Hidden"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Text, Mode=OneTime}" Style="{StaticResource LegendSegmentTextStyle}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </DataTemplate>
        <!-- A legend check box (B6, D69): selects crates; a ticked line has no box. Frame and mark (tick and bar) take their own
             colours from the legend's look (K4.1), grey by default.
             Ticked = all selected, a bar = part of them. Three states only with IsThreeState
             (source: https://learn.microsoft.com/dotnet/api/system.windows.controls.primitives.togglebutton.isthreestate);
             the click's own next state doesn't matter, ToggleCratesCommand changes the selection and the binding shows it. -->
        <Style x:Key="LegendCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="IsThreeState" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border BorderBrush="{DynamicResource LegendCheckBoxBrush}" BorderThickness="1.5"
                                Background="{StaticResource HitTestBackgroundBrush}">
                            <Grid>
                                <Path x:Name="Mark" Data="M 1.5,4.5 L 3.8,7 L 7.5,1.5" Stroke="{DynamicResource LegendCheckMarkBrush}"
                                      StrokeThickness="1.5" Visibility="Hidden" />
                                <Rectangle x:Name="Part" Width="5" Height="1.5" Fill="{DynamicResource LegendCheckMarkBrush}" Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Part" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Glyph buttons in the header (pencil, gear, split, merge, exit): hidden while locked, but keeping their space. -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The header's ship selection (T7.2b): closed it looks like the ship name, with a chevron; the list in the header's
             colours on the window colour without transparency, since it stands over the game. Not focusable, like the
             header buttons: focusing would activate the overlay. Without keyboard focus the closed box ignores the wheel,
             and a selection changes only by a click in the open list or by Enter in the search.
             Open, the name line is the search field (T7.2c, D60): the one place the overlay takes the keyboard. As wide as
             the list and as high as one entry, outlined like the buttons, 2 px above the list.
             Parts: https://learn.microsoft.com/dotnet/desktop/wpf/controls/combobox (PART_Popup, ItemsPresenter in a
             ScrollViewer). Source: dotnet/wpf, PresentationFramework/System/Windows/Controls/ComboBox.cs (OnMouseWheel) -->
        <!-- The slim bar's track above and below the thumb: invisible, but it takes the click that pages. -->
        <Style x:Key="SlimScrollPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A slim bar instead of the system's light grey one, for the ship list and the legend's stop lines (K7): no arrows,
             an invisible track that pages on click, a thumb in the Foreground that brightens under the mouse. Each user sets
             Foreground: the header's colour in the list, the legend's in the legend. Vertical only, neither scrolls sideways.
             Parts: https://learn.microsoft.com/dotnet/desktop/wpf/controls/scrollbar (PART_Track) -->
        <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!-- Reversed: a vertical track counts upwards, a scroll bar downwards. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2,2,2">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource SlimScrollPageButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Foreground="{TemplateBinding Foreground}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" CornerRadius="2" Opacity="0.35" Background="{TemplateBinding Foreground}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Grip" Property="Opacity" Value="0.6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShipBoxStyle" TargetType="ComboBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="420" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text, Mode=OneTime}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <!-- Ships that didn't load stay visible with their reason (D56), but can't be chosen. Without the
                         automation name a screen reader reads the record's ToString(). -->
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneTime}" />
                        <Setter Property="IsEnabled" Value="{Binding IsSelectable, Mode=OneTime}" />
                        <Setter Property="ToolTip" Value="{Binding Problem, Mode=OneTime}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Grid Background="{StaticResource HitTestBackgroundBrush}">
                                        <Border x:Name="Highlight" Background="{DynamicResource HeaderForegroundBrush}" Opacity="0" />
                                        <ContentPresenter x:Name="Content" Margin="16,2,8,2" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Highlight" Property="Opacity" Value="0.12" />
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Highlight" Property="Opacity" Value="0.25" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Content" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Opens on press, as the system's box does; the ComboBox closes it again. -->
                            <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <DockPanel Background="{StaticResource HitTestBackgroundBrush}">
                                            <!-- E70D ChevronDown. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                                            <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="{StaticResource IconFontFamily}"
                                                       FontSize="10" Margin="6,4,0,0"
                                                       Foreground="{DynamicResource HeaderForegroundBrush}"
                                                       Effect="{DynamicResource HeaderHaloEffect}" />
                                            <!-- One line: the header's style wraps, and the 30 px header holds two (D67). -->
                                            <TextBlock Text="{Binding Ship.Name, Mode=OneWay}" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{StaticResource HeaderTextStyle}" />
                                        </DockPanel>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- The search field over the name while the list is open (T7.2c). The text margins are one less
                                 than an entry's, which the outline takes: as high as one entry. Placeholder while empty. -->
                            <Border x:Name="SearchArea" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Width="{Binding ActualWidth, ElementName=PopupBorder}"
                                    Background="{DynamicResource WindowOpaqueBackgroundBrush}"
                                    BorderBrush="{DynamicResource ButtonsBorderBrush}" BorderThickness="1" CornerRadius="4">
                                <Grid>
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search ships…" Opacity="0.6" Margin="2,1,8,1"
                                               Visibility="Collapsed" IsHitTestVisible="False"
                                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                                    <TextBox x:Name="ShipSearch" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,1,8,1"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource HeaderForegroundBrush}"
                                             CaretBrush="{DynamicResource HeaderForegroundBrush}"
                                             AutomationProperties.Name="Search ships" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border x:Name="PopupBorder" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource WindowOpaqueBackgroundBrush}"
                                        BorderBrush="{DynamicResource ButtonsBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="0,2">
                                    <ScrollViewer>
                                        <ScrollViewer.Resources>
                                            <!-- The slim bar in the header's colour. -->
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="SearchArea" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, ElementName=ShipSearch}" Value="">
                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Locked: hidden like the header buttons; the name shows as text instead (header). -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Text button on the dark overlay: outline in the legend's text colour instead of the system's grey button.
             The outline is its own, not the glyph buttons' frame; background, corners and halo are the buttons' (D31). -->
        <Style x:Key="TextButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource ButtonsBackgroundBrush}"
                                BorderBrush="{DynamicResource LegendForegroundBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource ButtonsCornerRadius}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Effect="{DynamicResource ButtonsHaloEffect}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="{DynamicResource WindowBorderThickness}"
            CornerRadius="4" Padding="10">
        <!-- Named for the stop lines' highest height (K7): a share of this height, which follows the window, not the legend. -->
        <DockPanel x:Name="OverlayContent">
            <!-- Header: grip for moving the window (DragMove), later the tab bar (T3.7 notes).
                 Height and right margin keep clear of the lock window (36 px at 4 px inset, LockWindowPlacement). -->
            <!-- "All stops delivered." sits here, not in the legend: the header's fixed height keeps the ship view still (D16). -->
            <DockPanel DockPanel.Dock="Top" Height="30" Margin="0,0,30,0">
                <!-- Exits the app, next to the padlock, without a dialog: closes the overlay like the taskbar does, so its
                     Closed handlers write what is pending (bounds, settings, plan). Hidden while locked like every header
                     button (D34, addendum T5.1). -->
                <Button DockPanel.Dock="Right" ToolTip="Exit" Click="OnExit" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E8BB ChromeClose. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <!-- Opens the settings window, left of the exit button: window controls right, plan controls left of them (D34).
                     Hidden while locked like every header button. Over an invisible theme the system tool tip still finds
                     it: the button background keeps alpha 1, so it takes the hover (user guide, "Overlay unreadable?"). -->
                <Button DockPanel.Dock="Right" ToolTip="Settings" Click="OnOpenSettings" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E713 Setting. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <!-- Reset view (K1.3) right next to the gear, like a double-click next to the cargo: a view control, so right of
                     the plan's undo and redo (D34); they come and go further left, so it never jumps. Always there, hidden
                     while locked like every header button. -->
                <Button DockPanel.Dock="Right" Command="{Binding ResetViewCommand, Mode=OneTime}" ToolTip="Reset view" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E9A6 FitPage. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE9A6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <!-- Undo and redo (K2.4) left of the reset, ↶ ↷: each only while there is a step for it (the border collapses),
                     hidden while locked like every header button (the button's style keeps that, a local Visibility on the
                     button would override its trigger). -->
                <Border DockPanel.Dock="Right" Visibility="{Binding CanRedo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding RedoCommand, Mode=OneTime}" ToolTip="Redo" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E7A6 Redo. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                </Border>
                <Border DockPanel.Dock="Right" Visibility="{Binding CanUndo, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding UndoCommand, Mode=OneTime}" ToolTip="Undo" Style="{StaticResource HeaderButtonStyle}">
                        <!-- E7A7 Undo. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                        <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                                   Foreground="{DynamicResource HeaderForegroundBrush}" />
                    </Button>
                </Border>
                <!-- Opens the mission editor, left of the gear. Locked it is hidden but keeps its space (T3.7 notes):
                     planning is a step with a free cursor, and a locked overlay is click-through anyway. -->
                <Button DockPanel.Dock="Right" ToolTip="Enter missions" Click="OnOpenEditor" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E70F Edit. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <!-- Re-plan (D66) between the pencil and merge, Martin's choice after B4: also here, not only in the editor.
                     It asks first (ConfirmDialog), then the notice line says what happened; disabled, the tool tip says why,
                     like split and merge. -->
                <Button DockPanel.Dock="Right" Command="{Binding ReplanCommand, Mode=OneTime}" ToolTip="{Binding ReplanToolTip}"
                        ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E72C Refresh. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <!-- Merge and split the selected crates when the kiosk delivered others than planned (D27); left of the re-plan button,
                     hidden while locked like it. Disabled, the tool tip says why (ShowOnDisabled).
                     Source: https://learn.microsoft.com/dotnet/api/system.windows.controls.tooltipservice.showondisabled -->
                <Button DockPanel.Dock="Right" Command="{Binding MergeCommand, Mode=OneTime}" ToolTip="{Binding MergeToolTip}"
                        ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E71B Link. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding SplitCommand, Mode=OneTime}" ToolTip="{Binding SplitToolTip}"
                        ToolTipService.ShowOnDisabled="True" Style="{StaticResource HeaderButtonStyle}">
                    <!-- E8C6 Cut. Source: https://learn.microsoft.com/windows/apps/design/style/segoe-ui-symbol-font -->
                    <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"
                               Foreground="{DynamicResource HeaderForegroundBrush}" />
                </Button>
                <TextBlock DockPanel.Dock="Right"
                           Text="{x:Static vm:OverlayViewModel.AllDeliveredText}"
                           VerticalAlignment="Top"
                           Margin="6,0,0,0"
                           Foreground="{StaticResource DeliveredForegroundBrush}"
                           Effect="{DynamicResource HeaderHaloEffect}"
                           Visibility="{Binding Scene.AllDelivered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!-- Ship name and capacity, left-aligned, so the header right of them still moves the window. The capacity
                     (D67) is docked right of the name, which as the last child takes what is left and trims: the name gives
                     way, the capacity never. No IsLocked trigger: it is information, not a control, and stays while locked. -->
                <DockPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock x:Name="CapacityText" DockPanel.Dock="Right"
                               Text="{Binding Scene.CapacityText, Mode=OneWay}"
                               ToolTip="{Binding Scene.CapacityToolTip, Mode=OneWay}"
                               TextWrapping="NoWrap"
                               Margin="8,0,0,0"
                               Style="{StaticResource HeaderTextStyle}" />
                    <!-- The ship selection sits on the ship name, where haulers look for it (T7.2b, D59). Locked: the name as
                         text, like the hidden buttons. -->
                    <Grid VerticalAlignment="Top">
                        <Grid.Resources>
                            <!-- Grouped in the order of first appearance; ShipChoices.Of sorts. OneWay: Recent changes with the ship (T7.2c). -->
                            <CollectionViewSource x:Key="ShipsView" Source="{Binding ShipSelection, Mode=OneWay}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </Grid.Resources>
                        <ComboBox x:Name="ShipBox" Style="{StaticResource ShipBoxStyle}"
                                  ItemsSource="{Binding Source={StaticResource ShipsView}}"
                                  ToolTip="Your ship. Click to change it; a plan is planned anew for the new ship."
                                  IsSynchronizedWithCurrentItem="False"
                                  DropDownOpened="OnShipListOpened" DropDownClosed="OnShipListClosed"
                                  SelectionChanged="OnShipSelectionChanged">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,6,8,2"
                                                       Foreground="{DynamicResource HeaderForegroundBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                        <TextBlock Text="{Binding Ship.Name, Mode=OneWay}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </DockPanel>

            <!-- Problems with settings (D13), hotkeys (D17) and the plan file, one line per source (D18). Always the bottom
                 line, full width and left-aligned, wherever the legend stands (D33, addendum T5.1): docked before the legend
                 area, so a bottom legend stands above it, and a notice coming and going never moves a top legend or the
                 ship view's top edge. Inside the aligned block a long notice would widen it and move the stop lines. -->
            <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notices, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource NoticeTextStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Legend area (D33): below the ship view or between header and view, switched live through the view model
                 (T4.2), not built once at startup. Before the ship view, which stays the last child and fills the rest.
                 Changing DockPanel.Dock re-measures the parent DockPanel (OnDockChanged → InvalidateMeasure).
                 Source: https://github.com/dotnet/wpf/blob/main/src/Microsoft.DotNet.Wpf/src/PresentationFramework/System/Windows/Controls/DockPanel.cs -->
            <DockPanel>
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="DockPanel.Dock" Value="Bottom" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LegendPosition.Edge}" Value="{x:Static st:LegendEdge.Top}">
                                <Setter Property="DockPanel.Dock" Value="Top" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- Legend: one line per stop, then violations (red racks) and planner hints, word for word (D7).
                     A click on a stop line ticks it off or back (D16, addendum T3.8b: a plain line, no check box); a right drag of
                     a stop line into the ship view moves the whole stop to the rack under the cursor (D25). The lines
                     are buttons and handle their left clicks, so DragMove works on the header, the lines below the stops and the border,
                     not on the stop lines.
                     A block as wide as its lines, left, centred or right as a whole; inside, everything stays left-aligned, so
                     the swatches stand in one column (D33). The hidden hint reserve counts towards its width and height, so
                     ticking moves neither the block nor the ship view in any position (D16). The gap faces the ship view. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="0,6,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LegendPosition.Edge}" Value="{x:Static st:LegendEdge.Top}">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LegendPosition.Alignment}" Value="{x:Static st:LegendAlignment.Center}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LegendPosition.Alignment}" Value="{x:Static st:LegendAlignment.Right}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Empty state: the sentence and a second way into the editor besides the pencil. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlan}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static vm:OverlayViewModel.NoPlanText}" Style="{StaticResource LegendTextStyle}" />
                        <Button Content="Open editor" Click="OnOpenEditor" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Style="{StaticResource TextButtonStyle}" />
                    </StackPanel>
                    <!-- Hidden by legend.visible = false: only the stop lines go (D33). Warnings and the empty state stay,
                         notices are at the bottom anyway; a stop is then ticked in the ship view and moved through the crate selection.
                         The lines scroll beyond their share of the overlay (K7, D80); what follows them never scrolls. No
                         horizontal range: the lines get the width, so they shorten (K6.1). Not focusable: a focus would
                         activate the overlay, and a ScrollViewer that takes the focus handles the left click DragMove needs.
                         Source: dotnet/wpf, PresentationFramework/System/Windows/Controls/ScrollViewer.cs (OnMouseLeftButtonDown) -->
                    <ScrollViewer x:Name="StopLinesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ScrollViewer.MaxHeight>
                            <MultiBinding Converter="{StaticResource LegendMaxHeightConverter}" Mode="OneWay">
                                <Binding ElementName="OverlayContent" Path="ActualHeight" Mode="OneWay" />
                                <Binding Path="LegendMaxHeightShare" Mode="OneWay" />
                            </MultiBinding>
                        </ScrollViewer.MaxHeight>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLegendVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ScrollViewer.Resources>
                            <!-- The slim bar in the legend's colour. -->
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource LegendForegroundBrush}" />
                            </Style>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Scene.Legend, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <!-- The command replaces the plan, so the legend is rebuilt and the grey comes from the new entry. -->
                                <DataTemplate DataType="{x:Type sv:LegendEntry}">
                                    <!-- "From A, B" or "From ?" over the first line of a mission once any mission has a pickup (B6,
                                         D69): no tick of its own, it goes with the lines when the legend is hidden (D33). Its check box
                                         selects the mission's crates on board, a right drag of the header moves them. Each line has a
                                         check box of its own for its crates, outside the line's button: a click on the box selects, a
                                         click on the line ticks, a right drag of the line moves its crates. A box shows ticked while all
                                         its crates are selected, a bar for part (LegendCheckedConverter). -->
                                    <StackPanel>
                                        <!-- Rows are DockPanels, not horizontal StackPanels: those measure their children at infinite
                                             width, and the text could never shorten (K6.1). The tool tip holds the whole text. -->
                                        <DockPanel x:Name="HeaderRow" Background="{StaticResource HitTestBackgroundBrush}"
                                                   MouseRightButtonDown="OnLegendHeaderRightButtonDown" ToolTip="{Binding HeaderLabel, Mode=OneTime}">
                                            <CheckBox x:Name="MissionCheck" DockPanel.Dock="Left" Style="{StaticResource LegendCheckBoxStyle}"
                                                      Command="{Binding DataContext.ToggleCratesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding MissionCrates, Mode=OneTime}">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource LegendCheckedConverter}" Mode="TwoWay">
                                                        <Binding Path="MissionCrates" Mode="OneWay" />
                                                        <Binding Path="DataContext.Selection" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.Scene" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                            <!-- "From Lorville" · " · #47": the pickups shorten, the ContractTracker id never (K6.1). -->
                                            <ItemsControl x:Name="HeaderText" ItemsSource="{Binding HeaderSegments, Mode=OneTime}"
                                                          ItemTemplate="{StaticResource LegendSegmentTemplate}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <sv:LegendRowPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="sv:LegendRowPanel.Rank" Value="{Binding Rank, Mode=OneTime}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </DockPanel>
                                        <DockPanel x:Name="LineRow">
                                            <CheckBox x:Name="LineCheck" DockPanel.Dock="Left" Style="{StaticResource LegendCheckBoxStyle}"
                                                      Command="{Binding DataContext.ToggleCratesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding Crates, Mode=OneTime}">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource LegendCheckedConverter}" Mode="TwoWay">
                                                        <Binding Path="Crates" Mode="OneWay" />
                                                        <Binding Path="DataContext.Selection" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="DataContext.Scene" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                            <!-- A click ticks this line, one mission's crates for one destination (B6, D69); a click on a
                                                 crate in the ship view ticks the whole stop. -->
                                            <Button x:Name="LineButton"
                                                    Command="{Binding DataContext.ToggleLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Mode=OneTime}"
                                                    Style="{StaticResource LegendLineButtonStyle}"
                                                    MouseRightButtonDown="OnLegendRightButtonDown"
                                                    ToolTip="{Binding Label, Mode=OneTime}">
                                                <DockPanel x:Name="LineContent">
                                                    <!-- The stop's ordinal and the overlay's palette, the brush the view paints its
                                                         crates with, hatch included (K4.2). -->
                                                    <Rectangle x:Name="Swatch" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,6,0">
                                                        <Rectangle.Fill>
                                                            <MultiBinding Converter="{StaticResource PaletteBrushConverter}" Mode="OneWay">
                                                                <Binding Path="PaletteIndex" Mode="OneTime" />
                                                                <Binding Path="DataContext.StopPalette" Mode="OneWay" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <!-- "To Green Glade Station" · " · 5 SCU (4+1)" · " · Pressurized Ice" · markings (K6.1):
                                                         the commodity shortens first, then the destination; quantity, mix and markings never.
                                                         The markings carry the reserve, so a tick keeps the line's width (D16, D33). The Tag
                                                         tells the segments that the line is delivered (LegendSegmentTextStyle). -->
                                                    <ItemsControl x:Name="LineText" ItemsSource="{Binding Segments, Mode=OneTime}" Tag="{Binding Delivered, Mode=OneTime}"
                                                                  ItemTemplate="{StaticResource LegendSegmentTemplate}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <sv:LegendRowPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="sv:LegendRowPanel.Rank" Value="{Binding Rank, Mode=OneTime}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                    </ItemsControl>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </StackPanel>
                                    <!-- Template triggers outrank values set in the template, so the grey wins over the bound colour.
                                         Hidden, not collapsed, boxes keep their column, so swatches and headers stay aligned.
                                         Source: https://learn.microsoft.com/dotnet/desktop/wpf/properties/dependency-property-value-precedence -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Header}" Value="{x:Null}">
                                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MissionCrates}" Value="{x:Null}">
                                            <Setter TargetName="MissionCheck" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Grouped}" Value="True">
                                            <Setter TargetName="LineRow" Property="Margin" Value="18,0,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Delivered}" Value="True">
                                            <Setter TargetName="LineCheck" Property="Visibility" Value="Hidden" />
                                            <Setter TargetName="Swatch" Property="Fill" Value="{x:Static sv:MissionPalette.DeliveredBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Missions that didn't fit (D41): a hollow swatch, the reason, and a click drops the mission. Shown even
                         with legend.visible = false, like the warnings: they ask for something (T5.4). -->
                    <ItemsControl ItemsSource="{Binding Scene.Unplaced, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sv:UnplacedEntry}">
                                <Button Command="{Binding DataContext.DropMissionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding MissionId, Mode=OneTime}"
                                        Style="{StaticResource LegendLineButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="12" Height="12" Margin="0,0,6,0" Fill="Transparent"
                                                   Stroke="{DynamicResource LegendForegroundBrush}" StrokeThickness="1" />
                                        <TextBlock Text="{Binding Label, Mode=OneTime}" Style="{StaticResource LegendTextStyle}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Scene.Violations, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Mode=OneTime}" Style="{StaticResource LegendTextStyle}"
                                           Foreground="{x:Static sv:MissionPalette.ViolationBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- More stops than colours, from the stop count and the palette (K4.2): empty, and collapsed, while none repeat. -->
                    <TextBlock x:Name="PaletteNotice">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource PaletteNoticeConverter}" Mode="OneWay">
                                <Binding Path="Scene.StopCount" Mode="OneWay" />
                                <Binding Path="StopPalette" Mode="OneWay" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource LegendTextStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Last child fills the rest. Left drag here orbits, a click on cargo ticks its stop, right drag on a crate
                 puts it on the cell under the cursor, right drag elsewhere pans; DragMove works on header, warning lines and border.
                 The hologram is part of the ship view's 3D scene (D83): crates inside the hull show through it. -->
            <Grid>
                <!-- One selected crate: pickup · commodity · destination (T7.4d). Over the view, not above it: a line that came
                     and went with the selection would refit the ship under the cursor. Never hit, so the view keeps the mouse. -->
                <TextBlock Text="{Binding SelectionInfo, Mode=OneWay}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectionInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <sv:ShipViewControl x:Name="ShipView"
                                    Scene="{Binding Scene, Mode=OneWay}"
                                    ToggleStopCommand="{Binding ToggleDeliveredCommand, Mode=OneTime}"
                                    MoveCratesCommand="{Binding MoveCratesCommand, Mode=OneTime}"
                                    MoveLegendCommand="{Binding MoveLegendCommand, Mode=OneTime}"
                                    Selection="{Binding Selection}"
                                    MaxPxPerCell="{Binding MaxZoomPxPerCell, Mode=OneWay}"
                                    StopPalette="{Binding StopPalette, Mode=OneWay}"
                                    Camera="{Binding Camera}"
                                    Holo="{Binding Holo, Mode=OneWay}"
                                    HoloOpacity="{Binding HoloOpacity, Mode=OneWay}"
                                    HoloHullColor="{Binding HoloHullColor, Mode=OneWay}"
                                    HoloEdgeColor="{Binding HoloEdgeColor, Mode=OneWay}"
                                    CrateFillAlpha="{DynamicResource CratesFillAlpha}"
                                    CrateEdgeBrush="{DynamicResource CratesEdgeBrush}"
                                    RackNumberBrush="{DynamicResource CratesRackNumberBrush}"
                                    RackNumberFontSize="{DynamicResource CratesRackNumberFontSize}"
                                    RackNumberHaloBrush="{DynamicResource CratesHaloBrush}"
                                    RackNumberHaloSize="{DynamicResource CratesHaloSize}"
                                    SelectionPen="{DynamicResource CratesSelectionPen}"
                                    SelectionOutlinePen="{DynamicResource CratesSelectionOutlinePen}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
