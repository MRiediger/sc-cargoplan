<Application x:Class="CargoPlan.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:CargoPlan.App">
    <!-- No StartupUri: App.OnStartup builds the view model and the window. -->
    <Application.Resources>
        <!-- What a player can set (window, header, legend, crates, buttons) is not here: ThemeResources.Apply adds it
             to this dictionary from settings.json at startup, the views bind it by DynamicResource (D31). Below are the
             fixed parts of the overlay look: state colours and fonts. -->
        <FontFamily x:Key="PlanFontFamily">Consolas</FontFamily>
        <!-- Lock window: accent marks "locked" next to the glyph, readable from the pilot seat. -->
        <SolidColorBrush x:Key="LockedForegroundBrush" Color="#FFFFB000" />
        <!-- Notice lines (settings, hotkeys, plan file): same amber, they ask for attention the same way. -->
        <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#FFFFB000" />
        <!-- Legend line of a delivered stop: dimmed, but lighter than the delivered cell grey, which is unreadable as text. -->
        <SolidColorBrush x:Key="DeliveredForegroundBrush" Color="#FF8C8C8C" />
        <!-- Lock window sits on the overlay's background and adds none of its own. Alpha 1, not 0:
             a layered window passes clicks on fully transparent pixels to the window below. -->
        <SolidColorBrush x:Key="HitTestBackgroundBrush" Color="#01000000" />
        <!-- Icon font that ships with Windows 10/11; a glyph instead of an emoji, whose font fallback is unreliable. -->
        <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
        <!-- Glyph buttons on the overlay (padlock, pencil, split, merge): by default no own look, the glyph is the button;
             background, frame, corners and halo come from settings.json (D31).
             Not focusable: focusing would activate the window and take the foreground from the game. -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource ButtonsBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonsBorderBrush}"
                                BorderThickness="{DynamicResource ButtonsBorderThickness}"
                                CornerRadius="{DynamicResource ButtonsCornerRadius}">
                            <!-- Halo on the content, not the border: it outlines the glyph, not the box. -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Effect="{DynamicResource ButtonsHaloEffect}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Split and merge without a fitting selection (D27): faded, the tool tip says why. -->
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Mission editor: a normal window with the system look; only its markings need colours. -->
        <SolidColorBrush x:Key="InvalidRowBrush" Color="#FFFFD6D6" />
        <SolidColorBrush x:Key="EditorProblemBrush" Color="#FFB00020" />
        <SolidColorBrush x:Key="EditorWarningBrush" Color="#FF9A6700" />
        <!-- Settings window, also the system look (D34): a checkerboard behind each colour swatch makes its alpha visible. -->
        <DrawingBrush x:Key="SwatchCheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FFC8C8C8" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Hue slider of the colour picker (T4.2c): the spectrum is its track. Fluent's slider doesn't draw Background,
             so this template does; thumb and repeat buttons are Fluent's own styles, looked up in the tool window (D36). -->
        <Style x:Key="HueSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="{x:Static app:SaturationValuePad.HueSpectrum}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="22" Background="Transparent">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource SliderButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{DynamicResource SliderButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{DynamicResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
